# Local file only — never commit. In production use host secrets (Fly/Railway/etc.).
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./propopuli.db

# OpenAI: backend only. Gate uses heuristics when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Resend (verify + password reset) — backend only
# Test sender onboarding@resend.dev only delivers to the email you verified in Resend until you add a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProPopuliAPP <onboarding@resend.dev>
APP_PUBLIC_URL=http://localhost:3000

# Platform operator (your account): delete any subpop, bar, timeout, pardon. Comma-separated if multiple.
OPERATOR_HANDLES=YourHandleHere
OPERATOR_EMAILS=

# Shown on Contact page (mailto). Use your real admin inbox.
CONTACT_ADMIN_EMAIL=ProPopuliAPP@proton.me
