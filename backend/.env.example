# Local file only — never commit. In production use host secrets (Fly/Railway/etc.).
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./propopuli.db

# OpenAI: backend only. Gate uses heuristics when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Resend (verify email, later password reset) — backend only
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProPopuli <onboarding@yourdomain.com>
APP_PUBLIC_URL=http://localhost:3000
